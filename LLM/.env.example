# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있으므로 절대 커밋되지 않습니다.

# ---------------------------------------------------------
# 서비스
# ---------------------------------------------------------
LLM_SERVICE_PORT=8002

# live = 실제 LLM API 호출 / mock = 고정 응답
# API 키가 아직 없어도 팀원이 화면을 붙여볼 수 있게 하는 스위치입니다.
# 공개 API 계약은 두 모드가 완전히 동일하므로 프론트 코드는 바꿀 필요가 없습니다.
LLM_MODE=live

# 기본 프로바이더 (openai | gemini)
# 요청 body 의 "provider" 로 매 호출마다 덮어쓸 수 있습니다.
DEFAULT_PROVIDER=openai

# 응답 생성 타임아웃(초). 초과 시 504 + 한국어 안내 메시지 반환.
# 스토리보드(13p) "5초 -> 일시적인 오류입니다" 요구사항 기준.
LLM_TIMEOUT_SEC=5.0

# ---------------------------------------------------------
# OpenAI
# ---------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------
# Gemini
# ---------------------------------------------------------
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------
# Qwen (로컬 오픈소스, Ollama 경유)
# ---------------------------------------------------------
# 상용 API 비교용. API 키 없이 로컬에서 돌지만 Ollama 가 떠 있어야 합니다.
#   ollama pull qwen2.5:7b
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:7b
# Ollama 는 기본 5분 미사용 시 모델을 내립니다. 다음 호출이 로딩 4초를 물게 되므로 상주시킵니다.
QWEN_KEEP_ALIVE=30m

# ---------------------------------------------------------
# 주제 분류 방법
# ---------------------------------------------------------
# llm   = 현행. 프로바이더에 enum 제약 호출을 한 번 더 보냄
# embed = 임베딩 유사도로 분류. API 호출 없음, 로컬 모델 필요
TOPIC_METHOD=llm
TOPIC_EMBED_MODEL=jhgan/ko-sroberta-multitask

# ---------------------------------------------------------
# RAG 서비스 (Member C 담당, port 8001)
# ---------------------------------------------------------
# live = 실제 호출 / mock = 고정 응답으로 개발
RAG_MODE=mock
RAG_BASE_URL=http://localhost:8001
RAG_TIMEOUT_SEC=3.0
RAG_TOP_K=5

# ---------------------------------------------------------
# 계측 로그
# ---------------------------------------------------------
# 지연/토큰/모델명은 API 응답에 넣지 않고 이 파일에만 남깁니다.
# 성능 보고서(bench/report.py)가 이 파일을 읽어 집계합니다.
METRICS_PATH=logs/metrics.jsonl
METRICS_ENABLED=true
