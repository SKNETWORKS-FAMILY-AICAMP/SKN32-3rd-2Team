# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있으므로 절대 커밋되지 않습니다.

# ---------------------------------------------------------
# 서비스
# ---------------------------------------------------------
LLM_SERVICE_PORT=8001

# 기본 프로바이더 (openai | gemini)
# 요청 body 의 "provider" 로 매 호출마다 덮어쓸 수 있습니다.
DEFAULT_PROVIDER=openai

# 응답 생성 타임아웃(초). 초과 시 504 + 한국어 안내 메시지 반환.
# 스토리보드(13p) "5초 -> 일시적인 오류입니다" 요구사항 기준.
LLM_TIMEOUT_SEC=5.0

# ---------------------------------------------------------
# OpenAI
# ---------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------
# Gemini
# ---------------------------------------------------------
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------
# RAG 서비스 (Member C 담당, port 8002)
# ---------------------------------------------------------
# live = 실제 호출 / mock = 고정 응답으로 개발
RAG_MODE=mock
RAG_BASE_URL=http://localhost:8002
RAG_TIMEOUT_SEC=3.0
RAG_TOP_K=5

# ---------------------------------------------------------
# 계측
# ---------------------------------------------------------
# 요청별 지연/토큰 기록 파일 (성능 보고서 입력)
METRICS_PATH=bench/results/metrics.jsonl
METRICS_ENABLED=true
